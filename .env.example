# ====================================
# DENLA DISCOUNT SHOP - ENVIRONMENT CONFIGURATION
# ====================================
# ⚠️ FOR PRODUCTION: Generate new secrets before deployment!
# Use: openssl rand -base64 32

# ====================================
# NODE ENVIRONMENT
# ====================================
NODE_ENV=production
PORT=5000

# ====================================
# DATABASE CONFIGURATION
# ====================================
# For Coolify deployment (internal MySQL service name)
DB_HOST=denla-mysql
# For local development use: localhost
# For Docker Desktop use: host.docker.internal

DB_PORT=3306
DB_USER=denla
DB_PASSWORD=Hackifyoucan254
DB_NAME=denla
DB_CONNECTION_LIMIT=10

# ====================================
# JWT CONFIGURATION - CRITICAL!
# ====================================
# 🚨 GENERATE NEW SECRET: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_BEFORE_DEPLOYMENT_USE_OPENSSL_RAND_BASE64_32
JWT_EXPIRE=7d
JWT_EXPIRES_IN=7d

# ====================================
# SESSION CONFIGURATION - CRITICAL!
# ====================================
# 🚨 GENERATE NEW SECRET: openssl rand -base64 32
SESSION_SECRET=CHANGE_THIS_BEFORE_DEPLOYMENT_USE_OPENSSL_RAND_BASE64_32

# ====================================
# RATE LIMITING
# ====================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ====================================
# APPLICATION URL
# ====================================
# Update with your actual domain after deployment
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# ====================================
# CORS CONFIGURATION
# ====================================
# Add your frontend domains (comma-separated if multiple)
CORS_ORIGIN=https://your-domain.com

# ====================================
# WHATSAPP BUSINESS
# ====================================
WHATSAPP_BUSINESS_PHONE=+254704546916

# ====================================
# M-PESA INTEGRATION (OPTIONAL)
# ====================================
# Get credentials from: https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_from_daraja
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_from_daraja
MPESA_SHORTCODE=your_mpesa_shortcode
MPESA_PASSKEY=your_mpesa_passkey_from_daraja
MPESA_ENVIRONMENT=sandbox
MPESA_BASE_URL_SANDBOX=https://sandbox.safaricom.co.ke
MPESA_BASE_URL_PRODUCTION=https://api.safaricom.co.ke
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
MPESA_TIMEOUT_URL=https://your-domain.com/api/mpesa/timeout

# Backward compatibility
MPESA_BUSINESS_SHORT_CODE=${MPESA_SHORTCODE}

# ====================================
# EMAIL CONFIGURATION (OPTIONAL)
# ====================================
# For Gmail: Enable 2FA, then create App Password
# Guide: https://support.google.com/accounts/answer/185833
GMAIL_APP_PASSWORD=your_16_character_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_business_email@gmail.com
SMTP_PASSWORD=${GMAIL_APP_PASSWORD}

# ====================================
# GOOGLE OAUTH (OPTIONAL)
# ====================================
# Get from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ====================================
# COOLIFY DEPLOYMENT CHECKLIST
# ====================================
# ✅ 1. Generate JWT_SECRET: openssl rand -base64 32
# ✅ 2. Generate SESSION_SECRET: openssl rand -base64 32
# ✅ 3. Update DB_HOST to your MySQL service name
# ✅ 4. Update APP_URL with your actual domain
# ✅ 5. Update CORS_ORIGIN with your actual domain
# ✅ 6. Update MPESA_CALLBACK_URL with your actual domain
# ✅ 7. Add M-Pesa credentials if using payments
# ✅ 8. Add Gmail App Password if using email
# ⚠️ 9. NEVER commit .env file to Git!
# ✅ 10. Set NODE_ENV=production for deployment
